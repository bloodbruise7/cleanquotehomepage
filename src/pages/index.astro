    <section class="bg-white border-t border-line-card py-20 px-6">
      <div class="max-w-5xl mx-auto bg-navy rounded-card px-6 py-14 md:px-16 md:py-16 text-center">
        <h2 class="text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight mb-4">
          Quote the next house<br class="hidden md:block" /> on real hours
        </h2>
        <p class="text-base font-medium text-ink-on-navy-dim max-w-md mx-auto mb-8 leading-relaxed">
          Set up in an afternoon. Import your customers, price a job, send it, and let the clock do
          the rest.
        </p>
        <a href={LOGIN_URL} class={`${BTN_SECONDARY} !px-8 !py-3.5 !text-base`}>
          Start Free Trial
          <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} />
        </a>
        <p class="mt-5 text-sm font-medium text-ink-on-navy-dim">14 days free. No card. $39 a month after that.</p>
      </div>
    </section>
  </main>

  <Footer home />

  {/* ── LIGHTBOX ── */}
  <div
    id="lightbox"
    class="fixed inset-0 hidden items-center justify-center bg-navy-deep/90 p-4 sm:p-8 cursor-zoom-out"
    style="z-index: 9999;"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged screenshot"
    aria-hidden="true"
  >
    <button
      id="lightbox-close"
      type="button"
      aria-label="Close enlarged image"
      class="absolute top-4 right-4 sm:top-6 sm:right-6 w-10 h-10 rounded-full bg-white text-ink flex items-center justify-center z-10"
    >
      <Icon name="X" class="w-5 h-5" strokeWidth={2.5} />
    </button>
    <figure class="flex flex-col items-center gap-3 max-w-full max-h-full">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[82vh] w-auto h-auto object-contain rounded-card bg-white"
      />
      <figcaption id="lightbox-cap" class="text-center text-white/80 text-xs sm:text-sm font-medium max-w-2xl leading-snug px-2"></figcaption>
    </figure>
  </div>

  <script>
    const lb = document.getElementById('lightbox');
    const lbImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lbCap = document.getElementById('lightbox-cap');
    const closeBtn = document.getElementById('lightbox-close');

    if (lb && lbImg && lbCap && closeBtn) {
      const openLb = (src: string, alt: string) => {
        lbImg.src = src;
        lbImg.alt = alt;
        lbCap.textContent = alt;
        lb.classList.remove('hidden');
        lb.classList.add('flex');
        lb.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeLb = () => {
        lb.classList.add('hidden');
        lb.classList.remove('flex');
        lb.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        lbImg.src = '';
      };

      document.querySelectorAll<HTMLImageElement>('img[src^="/images/"]').forEach((img) => {
        img.style.cursor = 'zoom-in';
        img.setAttribute('tabindex', '0');
        img.setAttribute('role', 'button');
        img.addEventListener('click', () => openLb(img.currentSrc || img.src, img.alt));
        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLb(img.currentSrc || img.src, img.alt);
          }
        });
      });

      lb.addEventListener('click', (e) => {
        if (e.target !== lbImg) closeLb();
      });
      closeBtn.addEventListener('click', closeLb);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !lb.classList.contains('hidden')) closeLb();
      });
    }
  </script>
</Layout>
