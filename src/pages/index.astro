---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { LOGIN_URL, BTN_PRIMARY, BTN_SECONDARY, BTN_OUTLINE, EYEBROW, CHIP_NAVY, H2, LEAD, CARD, FIGURE } from '../site';

// Facts band
const facts = [
  { num: 'Hours × rate', label: "That's the whole formula. There is no hidden margin knob. The rate you set is your margin.", orange: true },
  { num: '25 timed visits', label: 'What it takes for the first calibration at a location. Then it runs again every 25.', orange: false },
  { num: '±5% per cycle', label: 'The most a calibration can move your estimates after the first one. No wild swings.', orange: true },
];

// Problem
const leaks = [
  {
    icon: 'TrendingDown',
    title: 'The two-hour job that took four',
    body: "You quoted from memory. The bathrooms were worse than the photos. Your crew ran over, and nobody got paid for the extra.",
  },
  {
    icon: 'MailX',
    title: 'The quote nobody chased',
    body: "It went out Tuesday. The customer opened it twice. By the time anyone remembered to follow up, they'd hired someone else.",
  },
  {
    icon: 'Route',
    title: 'The drive time you eat every week',
    body: "Monday's route zigzags across town because jobs got booked wherever they landed. That's an hour a day of fuel and payroll for nothing.",
  },
];

// How it works
const steps = [
  {
    n: '1',
    icon: 'Calculator',
    title: 'Estimate the time',
    body: 'Square footage, bedrooms, bathrooms, soil level, pets. Six service types, each on its own time curve. Out comes hours by crew size, and a price at your rate.',
  },
  {
    n: '2',
    icon: 'Send',
    title: 'Send it, book it, run it',
    body: 'The customer approves, signs, pays a deposit, and picks a real open slot. The visit lands on the schedule with its checklist. Your team clocks in on it.',
  },
  {
    n: '3',
    icon: 'RefreshCw',
    title: 'Let the clock correct you',
    body: 'Logged hours get compared to quoted hours. After 25 timed visits, CleanQuote adjusts the time curves. Slower than quoted goes up on its own. Lower prices always wait for your say-so.',
  },
];

// Calculator
const calcBullets = [
  'Six service types: Initial, Deep, Move In/Out, Weekly, Bi-Weekly, Monthly.',
  'Half-baths count in .5 steps. Pets, inside the oven, inside the fridge: one tap each.',
  'A Quote Confidence score shows which inputs you still haven’t filled in.',
  'Every location has its own rate, minimums, and calibration.',
];
const addonCalcs = [
  {
    icon: 'Droplets',
    title: 'Pressure washing',
    body: 'Surface, house, deck and fence, or roof. Minimums per service, chemical cost recovery per square foot, and multipliers for stories, pitch, and railings.',
  },
  {
    icon: 'Layers',
    title: 'Carpet cleaning',
    body: 'Room by room with stairs and pet-treatment spots. It picks the cheaper of per-spot or whole-room treatment so you don’t have to.',
  },
  {
    icon: 'Frame',
    title: 'Window cleaning',
    body: 'Counts by size, interior or exterior, glass condition, and a construction multiplier so post-build overspray isn’t on you.',
  },
];

// Calibration
const calibrationBullets = [
  'Residential, pressure washing, carpet, and window each calibrate on their own, per location.',
  'Only time curves move. Never your rate, never your add-on minutes.',
  'Saved quotes never change. An approval only touches future estimates.',
  'You get a notification for every run: adjusted, review recommended, or looking good.',
];

// Quotes
const quoteBullets = [
  'Approve, decline with a reason, or request changes.',
  'No reply in 5 days? CleanQuote creates a follow-up task for whoever sent it.',
  'Stale quotes archive themselves after 30 days.',
];

// Schedule
const scheduleBullets = [
  '“On My Way” texts from any visit: 15, 30, 45, 60 minutes, or a custom ETA.',
  'Six hours max per person per visit. Business hours and availability always hold.',
  'Anything that won’t fit gets flagged for you instead of forced in.',
];

// Time tracking
const timeBullets = [
  'Timesheets by person and day, with paid and unpaid totals.',
  'Every admin edit is logged with who, what, and why.',
  'Logged hours drive calibration and the Cleaner Efficiency report.',
];

// Automations
const automationBullets = [
  'Merge tags for the customer, the property, the quote, the visit, the invoice, and every link.',
  'Up to 25 custom rules on Solo, 50 on Team.',
  'Auto-draft an invoice when a job completes. Drafts never send themselves.',
];

// Payments
const payBullets = [
  'Reminders escalate at 3, 7, and 14 days past due.',
  'Available, pending, and instant payouts on one screen.',
  'An Expiring Cards report before the decline happens.',
];

// Everything included
const everything = [
  {
    title: 'Clients',
    img: '/images/clients.webp', w: 1400, h: 1023,
    alt: 'CleanQuote client list with phone, email, property address, lifecycle tags, and last activity.',
    body: 'Properties that pre-fill the next quote, scheduling preferences the organizer honors, notes, cards on file, and every text and email ever sent.',
  },
  {
    title: 'Reports',
    img: '/images/report-cleaner-efficiency.webp', w: 1400, h: 690,
    alt: 'Cleaner Efficiency report comparing estimated and actual hours per cleaner with variance, trend, and rating average.',
    body: 'Ten of them, CSV export on each: visit data, quotes, invoices, recurring revenue, customer lifetime value, cleaner efficiency, expenses.',
  },
  {
    title: 'Multi-location',
    img: '/images/locations.webp', w: 1400, h: 1125,
    alt: 'Locations settings showing Spartanburg and Greenville with their own hourly rates and enabled calculators.',
    body: 'Each branch owns its rate, calculators, calibration, phone number, and review link. Owners get an All Locations view.',
  },
  {
    title: 'Jobs and checklists',
    icon: 'ListChecks',
    body: "One-off or recurring on any pattern, including “third Thursday.” Checklists with photo and signature fields, emailed to the customer as a PDF.",
  },
  {
    title: 'Team roles',
    icon: 'Users',
    body: "Owner, office, and cleaner, enforced in the app and at the database. Cleaners see only the visits they’re on.",
  },
  {
    title: 'Expenses',
    icon: 'Receipt',
    body: "A receipt photo from the phone, categories you set, and “owed to Maria” when a cleaner buys the supplies.",
  },
  {
    title: 'Tasks',
    icon: 'ClipboardCheck',
    body: 'Non-billable to-dos on the same calendar as the visits. Quote follow-ups create themselves.',
  },
  {
    title: 'Import',
    icon: 'Import',
    body: 'Bring customers, quotes, jobs, and invoices in from a CSV. There’s a Jobber preset.',
  },
  {
    title: 'API and webhooks',
    icon: 'Webhook',
    body: 'Signed webhooks on five events with retries and a delivery log, plus an inbound endpoint with a Zapier walkthrough.',
  },
];

// Pricing
const plans = [
  {
    name: 'Solo Operator',
    price: '$39',
    tagline: 'One login. Every feature.',
    featured: false,
    features: [
      'All four calculators and the calibration engine',
      'Quotes, e-signature, deposits, self-booking',
      'Schedule, Organizer, timers, timesheets',
      'Invoicing, Stripe payments, 25 automation rules',
      'Customer portal and website widgets',
    ],
  },
  {
    name: 'Team Authority',
    price: '$69',
    tagline: 'Up to 5 team users.',
    featured: true,
    features: [
      'Everything in Solo',
      'Office and cleaning staff roles',
      'Per-cleaner timers and Cleaner Efficiency',
      'Multi-location rates and calibration',
      '50 custom automation rules',
    ],
  },
  {
    name: 'Enterprise',
    price: '$99',
    tagline: 'Up to 15 team users, then $9/month per extra seat.',
    featured: false,
    features: [
      'Everything in Team',
      'Room for a bigger crew across more branches',
      'Add seats past 15 for $9/month each',
      'A phone number per location with the Hub',
    ],
  },
];

const faqs = [
  {
    q: 'Do I need a credit card to start?',
    a: 'No. The trial is 14 days and you only add a card when you pick a plan. Cancel any time after that.',
  },
  {
    q: 'Will it lower my prices without asking?',
    a: 'Never. When your crew runs faster than quoted, CleanQuote recommends a decrease and waits for you to approve it. Increases apply on their own because that is money you were already losing.',
  },
  {
    q: 'Does it work for pressure washing, carpet, or windows?',
    a: 'Yes. Each has its own calculator and its own calibration. Residential house cleaning is the core, and the other three are there for companies that offer them as add-on lines.',
  },
  {
    q: 'Can I bring my customers over from Jobber?',
    a: 'Yes. The import wizard takes a CSV, maps the columns, verifies, and runs. There is a ready-made Jobber preset, and quotes, jobs, visits, and invoices can come along too.',
  },
  {
    q: 'What does the Communications Hub cost?',
    a: '$49 a month on any plan for a dedicated number, two-way texting, and calling from the dashboard. Extra numbers are $5 a month each.',
  },
];

// JSON-LD
const softwareSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'CleanQuote',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: 'https://thecleanquote.com/',
  description:
    'CleanQuote is the pricing and operations system for residential cleaning businesses: a time-first pricing calculator that recalibrates from timed visits, plus quotes, scheduling, time tracking, invoicing, Stripe payments, texting, a customer portal, and an MCP server.',
  offers: [
    { '@type': 'Offer', name: 'Solo Operator', price: '39', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Team Authority', price: '69', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Enterprise', price: '99', priceCurrency: 'USD' },
  ],
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const CHECK_BULLET = 'flex items-start gap-3 text-sm font-medium text-ink-body leading-relaxed';
const CHECK_DOT = 'mt-0.5 w-5 h-5 rounded-full bg-navy-tint text-navy flex items-center justify-center flex-shrink-0';
const ICON_TILE = 'w-11 h-11 rounded-xl bg-navy-tint text-navy flex items-center justify-center flex-shrink-0';
const CTA_ROW = 'inline-flex flex-wrap items-center gap-3';
---

<Layout
  title="CleanQuote — Time-Based Pricing Calculator & Operations System for Cleaning Businesses"
  description="CleanQuote prices every house on the hours it really takes, then recalibrates from your crew's timed visits. Quotes, scheduling, time tracking, invoicing, Stripe payments, texting, and a customer portal for residential cleaning companies. 14-day free trial, no card."
  canonical="https://thecleanquote.com/"
  ogTitle="CleanQuote — Price every house on real hours"
  ogDescription="The cleaning calculator that learns how fast your crew really works, and the system that runs everything off that number. 14 days free, no card."
  ogUrl="https://thecleanquote.com/"
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <Nav home />

  <main class="overflow-x-hidden">
    {/* ── HERO ── */}
    <section class="bg-page">
      <div class="max-w-6xl mx-auto px-6 pt-16 pb-14 md:pt-24 md:pb-20 grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class={`${CHIP_NAVY} mb-6`}>
            <Icon name="ClipboardCheck" class="w-3.5 h-3.5" strokeWidth={2.5} />
            Built for residential cleaning companies
          </span>

          <h1 class="text-4xl md:text-5xl font-extrabold text-ink tracking-tight leading-[1.1] mb-5">
            Price every house on real hours.
            <span class="block text-orange">Then let it learn from your crew.</span>
          </h1>

          <p class="text-lg text-ink-body font-medium leading-relaxed mb-8">
            CleanQuote works out the time first, prices it at your hourly rate, and recalibrates from
            your crew's timed visits. Quotes, scheduling, invoicing, payments, texting, a customer
            portal: all of it runs off that one calibrated number.
          </p>

          <div class={CTA_ROW}>
            <a href={LOGIN_URL} class={BTN_PRIMARY}>
              Start Free Trial
              <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} />
            </a>
            <a href="#calculator" class={BTN_OUTLINE}>
              See the calculator
              <Icon name="ChevronDown" class="w-4 h-4" strokeWidth={2.5} />
            </a>
          </div>

          <p class="mt-5 text-sm font-medium text-ink-secondary">
            14 days free. No credit card. Plans from $39 a month.
          </p>
        </div>

        <div class="relative">
          <div class="absolute -top-5 right-4 z-10 bg-white border border-line-card rounded-card px-4 py-3 hidden sm:flex items-center gap-3">
            <div class="relative w-14 h-14 flex-shrink-0">
              <svg viewBox="0 0 56 56" class="w-14 h-14 -rotate-90" aria-hidden="true">
                <circle cx="28" cy="28" r="22" fill="none" stroke="#eef1f6" stroke-width="5" />
                <circle cx="28" cy="28" r="22" fill="none" stroke="#1e8e4e" stroke-width="5" stroke-linecap="round" stroke-dasharray="130 138" />
              </svg>
              <div class="absolute inset-0 flex items-center justify-center text-sm font-extrabold text-success">94%</div>
            </div>
            <div>
              <div class="text-xs font-bold text-ink">Quote Confidence</div>
              <div class="text-xs font-semibold text-success">Excellent confidence</div>
            </div>
          </div>

          <div class={FIGURE}>
            <img
              src="/images/hero-estimate.webp"
              width="1400"
              height="790"
              fetchpriority="high"
              decoding="async"
              alt="CleanQuote pricing estimate showing a $540.39 initial cleaning and a $221.66 bi-weekly visit with estimated time for a team of one, two, or three, and a Calibrated Pricing V3 badge."
              class="w-full block"
            />
          </div>
        </div>
      </div>

      {/* Facts band */}
      <div class="max-w-6xl mx-auto px-6 pb-16 md:pb-20">
        <div class="grid sm:grid-cols-3 gap-4">
          {facts.map((s) => (
            <div class={`${CARD} p-6`}>
              <div class={`text-2xl font-extrabold tracking-tight ${s.orange ? 'text-orange' : 'text-navy'}`}>{s.num}</div>
              <div class="mt-1.5 text-sm font-medium text-ink-body leading-relaxed">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── PROBLEM ── */}
    <section class="bg-white border-y border-line-card py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class={EYEBROW}>Why quoting from feel costs you</div>
        <h2 class={H2}>Three leaks that don't show up<br class="hidden md:block" /> until Friday</h2>
        <p class={`${LEAD} max-w-xl mb-12`}>
          None of them look like much on the day. Add them up over a quarter and that's the raise you
          couldn't give.
        </p>

        <div class="grid md:grid-cols-3 gap-4">
          {leaks.map((c) => (
            <div class={`${CARD} p-6`}>
              <div class={ICON_TILE}><Icon name={c.icon} class="w-5 h-5" /></div>
              <h3 class="mt-5 font-bold text-ink text-base mb-2">{c.title}</h3>
              <p class="text-sm font-medium text-ink-body leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── HOW IT WORKS ── */}
    <section class="bg-page py-20 px-6">
      <div class="max-w-6xl mx-auto">
        <div class={EYEBROW}>How it works</div>
        <h2 class={H2}>One number runs the whole business</h2>
        <p class={`${LEAD} max-w-xl mb-12`}>
          The calculator produces it. Everything downstream uses it. The clock corrects it.
        </p>

        <div class="grid md:grid-cols-3 gap-4">
          {steps.map((c) => (
            <div class={`${CARD} p-6`}>
              <div class="flex items-center justify-between">
                <div class={ICON_TILE}><Icon name={c.icon} class="w-5 h-5" /></div>
                <span class="w-8 h-8 rounded-full bg-orange text-white text-xs font-extrabold flex items-center justify-center">{c.n}</span>
              </div>
              <h3 class="mt-5 font-bold text-ink text-base mb-2">{c.title}</h3>
              <p class="text-sm font-medium text-ink-body leading-relaxed">{c.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ── CALCULATOR ── */}
    <section id="calculator" class="bg-white border-y border-line-card py-20 px-6 scroll-mt-16">
      <div class="max-w-6xl mx-auto">
        <div class="grid md:grid-cols-2 gap-14 items-center">
          <div>
            <div class={EYEBROW}>The calculator</div>
            <h2 class={H2}>Built around time, because time is what you're selling</h2>
            <p class={`${LEAD} mb-3`}>
              Enter the home. CleanQuote returns the hours for a crew of one, two, or three, and the
              price at your rate. Not a range. A number you can defend on the phone.
            </p>
            <p class="text-sm font-medium text-ink-body leading-relaxed mb-7">
              Soil level moves the estimate from 10% under for a pristine home to 50% over for one
              that needs a site visit first. Pets add 5%. Inside the oven adds about 45 minutes, the
              fridge about an hour. Initial, deep, and move-out cleans price on a heavier curve than
              weekly or bi-weekly visits, so the "first clean plus per-visit price" structure is already
              in the quote instead of a discount you do in your head.
            </p>

            <ul class="space-y-3 mb-8">
              {calcBullets.map((item) => (
                <li class={CHECK_BULLET}>
                  <span class={CHECK_DOT}><Icon name="Check" class="w-3 h-3" strokeWidth={3} /></span>
                  {item}
                </li>
              ))}
            </ul>

            <a href={LOGIN_URL} class={BTN_PRIMARY}>Start Free Trial <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} /></a>
          </div>

          <div class={FIGURE}>
            <img
              src="/images/calculator-inputs.webp"
              width="1400"
              height="920"
              loading="lazy"
              decoding="async"
              alt="CleanQuote residential calculator with Recurring selected, Initial and Bi-Weekly services checked, soil level set to Dirty, and a 94% Quote Confidence badge."
              class="w-full block"
            />
          </div>
        </div>

        <div class="mt-14">
          <div class={EYEBROW}>Also in the box</div>
          <div class="grid md:grid-cols-3 gap-4">
            {addonCalcs.map((c) => (
              <div class={`${CARD} p-6`}>
                <div class={ICON_TILE}><Icon name={c.icon} class="w-5 h-5" /></div>
                <h3 class="mt-5 font-bold text-ink text-base mb-2">{c.title}</h3>
                <p class="text-sm font-medium text-ink-body leading-relaxed">{c.body}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    {/* ── CALIBRATION ── */}
    <section class="bg-page py-20 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-14 items-center">
        <div class={FIGURE}>
          <img
            src="/images/calibration.webp"
            width="1400"
            height="880"
            loading="lazy"
            decoding="async"
            alt="Pricing and Calibration settings showing residential calibration at version 3 with 27 data points analyzed and a last-calibrated date."
            class="w-full block"
          />
        </div>

        <div>
          <div class={EYEBROW}>The calibration engine</div>
          <h2 class={H2}>It learns from the clock, not from your gut</h2>
          <p class={`${LEAD} mb-3`}>
            Every completed visit with logged hours is a data point. After 25 of them at a location,
            CleanQuote compares what you quoted to what the job took and adjusts the time curves. Then
            it does it again every 25.
          </p>
          <p class="text-sm font-medium text-ink-body leading-relaxed mb-7">
            The rules are conservative on purpose. If your crew runs slower than quoted, estimates go
            up automatically. If they run 12 to 25% faster, CleanQuote recommends a decrease and waits
            for you to approve it. It never quietly lowers your prices. Each cycle is capped at 5%,
            well-rated visits count for more, and a visit that ran double or half its estimate gets
            shown to you instead of averaged in.
          </p>

          <ul class="space-y-3 mb-8">
            {calibrationBullets.map((item) => (
              <li class={CHECK_BULLET}>
                <span class={CHECK_DOT}><Icon name="Check" class="w-3 h-3" strokeWidth={3} /></span>
                {item}
              </li>
            ))}
          </ul>

          <a href={LOGIN_URL} class={BTN_PRIMARY}>Start Free Trial <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} /></a>
        </div>
      </div>
    </section>

    {/* ── QUOTES ── */}
    <section class="bg-white border-y border-line-card py-20 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-14 items-center">
        <div>
          <div class={EYEBROW}>Quotes</div>
          <h2 class={H2}>A quote the customer can say yes to at 9 p.m.</h2>
          <p class={`${LEAD} mb-3`}>
            It goes out by text or email under your name and logo. They open it in the browser, pick
            their options, scroll the terms, sign, and approve. No PDF, no phone tag.
          </p>
          <p class="text-sm font-medium text-ink-body leading-relaxed mb-7">
            Make the recurring plan a required choice and they pick weekly or bi-weekly right on the
            quote. Require a deposit and the approve button stays locked until Stripe has it. Once they
            approve, they book their own first visit from slots that are actually open: 30-minute
            buffers, crew availability, at least four days out. It shows up on your dashboard as
            "booked online."
          </p>

          <ul class="space-y-3 mb-8">
            {quoteBullets.map((item) => (
              <li class={CHECK_BULLET}>
                <span class={CHECK_DOT}><Icon name="Check" class="w-3 h-3" strokeWidth={3} /></span>
                {item}
              </li>
            ))}
          </ul>

          <a href={LOGIN_URL} class={BTN_PRIMARY}>Start Free Trial <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} /></a>
        </div>

        <div class="grid grid-cols-[1fr_auto] gap-4 items-start">
          <div class={FIGURE}>
            <img
              src="/images/quote-customer.webp"
              width="1200"
              height="1154"
              loading="lazy"
              decoding="async"
              alt="Customer-facing CleanQuote quote from Clearview Home Cleaning with an Initial Cleaning line and a Bi-Weekly Cleaning marked as a required choice."
              class="w-full block"
            />
          </div>
          <div class={`${FIGURE} w-28 sm:w-36 rounded-[22px]`}>
            <img
              src="/images/mobile-quote.webp"
              width="600"
              height="1298"
              loading="lazy"
              decoding="async"
              alt="The same customer quote on a phone."
              class="w-full block"
            />
          </div>
        </div>
      </div>
    </section>

    {/* ── PIPELINE ── */}
    <section class="bg-page py-20 px-6">
      <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-14 items-center">
        <div class={FIGURE}>
          <img
            src="/images/pipeline.webp"
            width="1400"
            height="1023"
            loading="lazy"
            decoding="async"
            alt="CleanQuote sales pipeline board with New Lead, Quote Sent, Quote Approved, Job Booked, and Recurring columns showing deal values and days since activity."
            class="w-full block"
          />
        </div>

        <div>
          <div class={EYEBROW}>Sales pipeline</div>
          <h2 class={H2}>Stages move on their own</h2>
          <p class={`${LEAD} mb-3`}>
            New Lead, Quote Sent, Quote Approved, Job Booked, Recurring. Nobody drags a card. Sending
            the quote moves it. The approval moves it. The first completed recurring visit moves it.
          </p>
          <p class="text-sm font-medium text-ink-body leading-relaxed mb-7">
            Cards turn amber after 7 quiet days and red after 14, so the deal going cold is the first
            thing you see. Website widget leads, API leads, and customers you add by hand all land
            here, and every stage change can fire an automation or a webhook.
          </p>
          <a href={LOGIN_URL} class={BTN_PRIMARY}>Start Free Trial <Icon name="ArrowRight" class="w-4 h-4" strokeWidth={2.5} /></a>
        </div>
      </div>
    </section>

