---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Pricing from "../components/Pricing.astro";
import { TRIAL_URL } from "../site";
import "../styles/homepage.css";
const title = "CleanQuote | Cleaning Business Software from $39/month";
const description =
  "Turn website visitors into booked cleaning jobs with tailored estimates, online booking, smart scheduling and Stripe payments. Start your 14-day free trial.";
const steps = [
  {
    title: "They tell you about their home.",
    short: "Home details",
    image: "demo-widget",
    alt: "CleanQuote website calculator with fictional home size, bedroom and bathroom details.",
    body: "Your website widget collects the details that change the job: home size, rooms, condition, extras and cleaning frequency. A new inquiry becomes a lead and a tailored estimate.",
    detail:
      "Works on your own website. No need to send every visitor through a phone call.",
  },
  {
    title: "They receive their own price.",
    short: "Tailored quote",
    image: "demo-pricing",
    alt: "CleanQuote pricing estimate showing fictional initial and biweekly cleaning options.",
    body: "CleanQuote estimates the work using your pricing settings. The customer receives a quote by email to review and approve, with initial and recurring service options.",
    detail:
      "The widget sends the quote privately. This preview shows the calculator inside CleanQuote.",
  },
  {
    title: "They choose an available time.",
    short: "Self-booking",
    image: "demo-booking",
    alt: "CleanQuote self-booking calendar showing a fictional October 6 arrival window.",
    body: "Once approved, eligible quotes offer online booking. Customers pick from available arrival times, with any required deposit handled before scheduling.",
    detail:
      "Booking follows your availability and setup. Qualifying recurring service continues on the booked day.",
  },
];
const faqs = [
  [
    "Can customers really book without calling me?",
    "Yes, when online booking is enabled and the quote is eligible. Your widget gathers home details and sends a tailored quote by email. After approval and any required deposit, the customer can choose from available arrival times. Your working hours, capacity and booking settings still apply.",
  ],
  [
    "What makes the calculator different?",
    "Its starting estimates are informed by thousands of real cleaning visits. It considers the home and the type of clean, then applies your rates. As your team logs actual work, calibration uses your own company’s data to refine time estimates. You can review your pricing settings as your business changes.",
  ],
  [
    "Does the website widget display prices to everyone?",
    "No. The widget collects the request and emails the customer their quote. Each lead gets a price based on the details they supplied and your settings, with a link to review and approve.",
  ],
  [
    "Are credit card payments included?",
    "Stripe integration is included. Connect and configure your Stripe account to accept payments. Payment processing fees apply separately; subscription pricing does not include card or bank transaction fees.",
  ],
  [
    "How do the AI tools work?",
    "Connect a compatible AI app through CleanQuote’s MCP tools to look up business information and work with supported clients, quotes, jobs and schedules. Available actions depend on the permissions you grant. Setup and a compatible AI service are required; that service may charge separately. You can revoke a connection.",
  ],
  [
    "What costs extra?",
    "The optional Communications Hub is $49/month. Additional phone numbers are $5/month each, with usage charges separate. Enterprise can add team members for $9/month each. Payment processing, applicable taxes and any third-party AI subscription are separate.",
  ],
  [
    "Can I try it before choosing a plan?",
    "Yes. Start a 14-day free trial with no credit card required. Create a sample quote, explore the schedule and see how the workflow fits your cleaning business.",
  ],
];
---

<Layout
  title={title}
  description={description}
  canonical="https://thecleanquote.com/"
  ogTitle={title}
  ogDescription={description}
  ogUrl="https://thecleanquote.com/"
>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <Nav home />
  <main id="main" class="home">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="audience">
            <span></span> Built for residential cleaning businesses
          </p>
          <h1>
            Book the clean.
            <br />
            Skip the phone tag.
          </h1>
          <p class="hero-lead">
            Let customers get a price built for their home and book their own
            cleaning. Keep your quotes, crew, schedule and payments together in
            CleanQuote.
          </p>
          <div class="hero-actions">
            <a class="button button-orange" href={TRIAL_URL}>
              Start Free Trial <Icon name="ArrowUpRight" />
            </a>
            <a class="text-link" href="#how-it-works">
              See how it works <Icon name="Play" class="w-4 h-4" />
            </a>
          </div>
          <p class="trial-note">14 days free. No credit card required.</p>
          <div class="hero-price">
            <strong>
              From $39<span>/month</span>
            </strong>
            <span>
              Big capability.
              <br />A small-business price.
            </span>
          </div>
        </div>
        <div class="hero-visual">
          <div class="workflow-label">
            <Icon name="MousePointerClick" />
            <span>From your website to your schedule</span>
          </div>
          <div class="hero-screen">
            <div class="screen-top">
              <span class="screen-dots" aria-hidden="true">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span>Your customer’s booking experience</span>
              <Icon name="LockKeyhole" class="w-4 h-4" />
            </div>
            <button
              class="image-zoom"
              data-zoom="/images/demo-booking.webp"
              aria-label="Enlarge the online booking screenshot"
            >
              <img
                src="/images/demo-booking.webp"
                alt="Actual CleanQuote booking screen with fictional demo data: a customer chooses an available arrival time."
                width="850"
                height="581"
                fetchpriority="high"
              />
            </button>
          </div>
          <div class="booking-note">
            <span class="round-check">
              <Icon name="Check" />
            </span>
            <div>
              <strong>The right price. A real opening.</strong>
              <span>A clear next step for your next customer.</span>
            </div>
          </div>
          <p class="demo-caption">
            Actual product screens. Fictional demonstration data.
          </p>
        </div>
      </div>
      <div class="wrap proof-strip">
        <p>
          <Icon name="ChartNoAxesCombined" />
          <span>
            Pricing informed by{" "}
            <strong>thousands of real cleaning visits</strong>
          </span>
        </p>
        <p>
          <Icon name="SlidersHorizontal" />
          <span>
            <strong>Your rates.</strong> Your business.
          </span>
        </p>
        <a href="#pricing">
          See plans & price comparisons{" "}
          <Icon name="ArrowDown" class="w-4 h-4" />
        </a>
      </div>
    </section>

    <section id="how-it-works" class="section tour-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="section-label">
            Your website can do more than collect a name.
          </p>
          <h2>
            Give every new lead
            <br />a way to become a booked job.
          </h2>
          <p>The customer moves forward while you keep running the business.</p>
        </div>
        <div class="tour">
          <div
            class="tour-tabs"
            role="tablist"
            aria-label="Explore the booking journey"
          >
            {steps.map((step, i) => (
              <button
                id={`tour-tab-${i}`}
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`tour-panel-${i}`}
                tabindex={i === 0 ? 0 : -1}
                data-step={i}
              >
                <span class="step-number">{i + 1}</span>
                {step.short}
                <Icon name="ChevronRight" class="w-4 h-4" />
              </button>
            ))}
          </div>
          {steps.map((step, i) => (
            <div
              id={`tour-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`tour-tab-${i}`}
              tabindex="0"
              hidden={i !== 0}
              class="tour-panel"
            >
              <div class="tour-copy">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <p class="tour-detail">{step.detail}</p>
                <a href={TRIAL_URL} class="text-link">
                  Try it with your business{" "}
                  <Icon name="ArrowUpRight" class="w-4 h-4" />
                </a>
              </div>
              <figure>
                <button
                  class="image-zoom"
                  data-zoom={`/images/${step.image}.webp`}
                  aria-label={`Enlarge ${step.short.toLowerCase()} screenshot`}
                >
                  <img
                    src={`/images/${step.image}.webp`}
                    alt={step.alt}
                    loading="lazy"
                    width="1000"
                    height="720"
                  />
                </button>
                <figcaption>
                  Actual product preview with fictional details and example
                  prices. Click to enlarge.
                </figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="calculator" class="section calculator-section">
      <div class="wrap feature-split">
        <div class="feature-copy">
          <span class="feature-icon">
            <Icon name="Calculator" />
          </span>
          <p class="section-label">The calculator behind the quote</p>
          <h2>
            A three-bedroom home
            <br />
            isn’t the whole story.
          </h2>
          <p>
            A first clean, a recurring visit and a move-out are different jobs.
            Your estimates should account for the work, so you’re not pricing
            every home from memory.
          </p>
          <ul class="benefit-list">
            <li>
              <Icon name="Check" />
              <span>
                <strong>A price tailored to the home.</strong> Size, rooms,
                condition, pets, frequency and selected extras inform the
                estimate.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>A starting point grounded in real work.</strong> The
                calculator is informed by thousands of real cleaning visits.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>It can learn from your team.</strong> Logged work feeds
                calibration, helping estimates reflect how your company cleans.
              </span>
            </li>
          </ul>
          <p class="small-note">
            Your rates stay yours. Recorded work helps refine the time estimates
            behind them.
          </p>
        </div>
        <div class="calculator-visual">
          <div class="formula-heading">
            <Icon name="House" />
            <span>Home details + estimated work + your rates</span>
          </div>
          <button
            class="image-zoom"
            data-zoom="/images/demo-pricing.webp"
            aria-label="Enlarge the cleaning estimate screenshot"
          >
            <img
              src="/images/demo-pricing.webp"
              alt="CleanQuote calculator displaying example initial and biweekly estimates and team time estimates."
              width="1140"
              height="698"
              loading="lazy"
            />
          </button>
          <div class="learning-loop">
            <Icon name="RefreshCw" />
            <p>
              <strong>Quote. Clean. Track. Refine.</strong>
              <span>Your actual work helps inform the next estimate.</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="section operations-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="section-label">Built for the work after the booking, too</p>
          <h2>
            Fewer loose ends.
            <br />
            More room to run your business.
          </h2>
        </div>
        <div class="feature-split organizer-feature">
          <figure class="product-figure">
            <button
              class="image-zoom"
              data-zoom="/images/demo-organizer.webp"
              aria-label="Enlarge Schedule Organizer screenshot"
            >
              <img
                src="/images/demo-organizer.webp"
                alt="Schedule Organizer showing proposed changes for fictional sample homes, with an Apply Changes button."
                width="896"
                height="648"
                loading="lazy"
              />
            </button>
            <figcaption>
              Review the proposal before applying changes. Fictional
              demonstration data.
            </figcaption>
          </figure>
          <div class="feature-copy">
            <span class="feature-icon blue">
              <Icon name="CalendarRange" />
            </span>
            <h3>
              Stop rebuilding the week
              <br />
              one appointment at a time.
            </h3>
            <p>
              The Schedule Organizer helps place recurring work around preferred
              days, cleaner availability and arrival times. Review its
              suggestions and choose what to apply.
            </p>
            <ul class="plain-benefits">
              <li>Keep recurring visits organized.</li>
              <li>Account for availability, travel and gaps.</li>
              <li>See current and proposed assignments side by side.</li>
              <li>Keep the final scheduling decision in your hands.</li>
            </ul>
            <a class="text-link" href={TRIAL_URL}>
              Put your schedule in order{" "}
              <Icon name="ArrowUpRight" class="w-4 h-4" />
            </a>
          </div>
        </div>
        <div class="operations-grid">
          <article>
            <Icon name="Users" />
            <h3>One place for the customer story.</h3>
            <p>
              Keep clients, quotes, jobs, visit notes and invoices connected.
              Spend less time piecing together what happened before the next
              clean.
            </p>
          </article>
          <article>
            <Icon name="Timer" />
            <h3>Know where the hours went.</h3>
            <p>
              Track work time, compare estimated and actual hours, and use
              reports to spot jobs that deserve a closer look.
            </p>
          </article>
          <article>
            <Icon name="Smartphone" />
            <h3>Keep the crew in the loop.</h3>
            <p>
              Open CleanQuote on a phone to check the schedule, review job
              details and track time while the work is happening.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section connected-section">
      <div class="wrap connected-grid">
        <article class="payment-feature">
          <span class="feature-icon mint">
            <Icon name="CreditCard" />
          </span>
          <p class="section-label">Invoicing & Stripe payments</p>
          <h2>
            The clean is done.
            <br />
            Make paying easy.
          </h2>
          <p>
            Send a professional invoice with online payment options. Accept
            credit cards through Stripe, handle deposits and keep payment
            history connected to the customer.
          </p>
          <div class="payment-flow" aria-label="Invoice to payment workflow">
            <span>
              <Icon name="FileText" />
              Invoice
            </span>
            <Icon name="ArrowRight" />
            <span>
              <Icon name="CreditCard" />
              Online payment
            </span>
            <Icon name="ArrowRight" />
            <span>
              <Icon name="CircleCheck" />
              Recorded
            </span>
          </div>
          <ul class="plain-benefits">
            <li>Card and supported bank payments</li>
            <li>Deposits and saved payment methods</li>
            <li>Invoices, balances and payment records together</li>
          </ul>
          <p class="small-note">
            Stripe setup required. Processing fees apply separately.
          </p>
        </article>
        <article class="ai-feature">
          <span class="feature-icon">
            <Icon name="Sparkles" />
          </span>
          <p class="section-label">AI connections through MCP</p>
          <h2>
            Your AI can work
            <br />
            with your business.
          </h2>
          <p>
            Connect a compatible AI app, including ChatGPT, Claude or Codex, to
            CleanQuote’s tools. Look up records and work with supported quotes,
            jobs and schedules through a conversation.
          </p>
          <div class="ai-prompts">
            <p>Example things to ask</p>
            <blockquote>“Show me the jobs coming up this week.”</blockquote>
            <blockquote>“Find the latest quote for Sample home A.”</blockquote>
          </div>
          <p class="ai-permissions">
            <Icon name="ShieldCheck" />
            <span>
              You choose the permissions.
              <br />
              You can revoke access.
            </span>
          </p>
          <p class="small-note">
            Connection setup and a compatible AI service required. Available
            actions depend on permissions; third-party charges may apply.
          </p>
        </article>
      </div>
      <div class="wrap hub-row">
        <Icon name="MessagesSquare" />
        <div>
          <h3>Need calls and texts in the same place?</h3>
          <p>
            Add the Communications Hub for a shared business inbox. Keep
            customer conversations closer to the work.
          </p>
        </div>
        <a href="#pricing">
          Optional add-on · $49/month <Icon name="ArrowDown" class="w-4 h-4" />
        </a>
      </div>
    </section>
    <Pricing />
    <section class="section faq-section">
      <div class="wrap faq-grid">
        <div>
          <p class="section-label">A few things you might be wondering</p>
          <h2>
            Know what
            <br />
            you’re getting.
          </h2>
          <p>
            Start with a sample quote. See how CleanQuote fits the way your
            company works.
          </p>
          <a class="button button-navy" href={TRIAL_URL}>
            Start Free Trial <Icon name="ArrowUpRight" />
          </a>
        </div>
        <div class="faqs">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <Icon name="Plus" class="w-5 h-5" />
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="final-cta">
      <div class="wrap">
        <div>
          <p>Less chasing. More cleaning.</p>
          <h2>
            Give your next customer
            <br />
            an easier way to book.
          </h2>
        </div>
        <div>
          <a class="button button-orange" href={TRIAL_URL}>
            Start Free Trial <Icon name="ArrowUpRight" />
          </a>
          <p class="trial-note">14 days free. No credit card required.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer home />
  <dialog id="image-dialog" aria-label="Enlarged product screenshot">
    <form method="dialog">
      <button class="dialog-close" aria-label="Close enlarged screenshot">
        <Icon name="X" />
      </button>
    </form>
    <img alt="" />
    <p>Actual product screen with fictional demonstration data.</p>
  </dialog>
</Layout>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-step]"),
  );
  const selectStep = (tab: HTMLButtonElement) => {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls")!,
      );
      if (panel) panel.hidden = !selected;
    });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectStep(tab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectStep(tabs[next]);
      tabs[next].focus();
    });
  });
  const dialog = document.querySelector<HTMLDialogElement>("#image-dialog");
  let opener: HTMLButtonElement | null = null;
  document
    .querySelectorAll<HTMLButtonElement>("[data-zoom]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        if (!dialog) return;
        const img = dialog.querySelector("img")!;
        img.src = button.dataset.zoom!;
        img.alt = button.querySelector("img")?.alt || "Product screenshot";
        opener = button;
        dialog.showModal();
      }),
    );
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => opener?.focus());
</script>
