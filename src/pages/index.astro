---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import Pricing from "../components/Pricing.astro";
import { TRIAL_URL } from "../site";
import "../styles/homepage.css";
const title = "CleanQuote | Cleaning Business Software from $39/month";
const description =
  "Turn website visitors into booked cleaning jobs with tailored estimates, online booking, smart scheduling and Stripe payments. Start your 14-day free trial.";
const steps = [
  {
    title: "They tell you about their home.",
    short: "Home details",
    image: "demo-widget",
    alt: "CleanQuote website calculator with fictional home size, bedroom and bathroom details.",
    body: "Your website widget collects the details that change the job: home size, rooms, condition, extras and cleaning frequency. A new inquiry becomes a lead and a tailored estimate.",
    detail:
      "Works on your own website. No need to send every visitor through a phone call.",
  },
  {
    title: "They receive their own price.",
    short: "Tailored quote",
    image: "demo-customer-quote",
    zoomImage: "demo-customer-quote-full",
    alt: "Reliable Housekeeping customer-facing quote with a fictional customer, no contact details, and prices calculated using Portland settings.",
    body: "CleanQuote estimates the work using your pricing settings. The customer receives a quote by email to review and approve, with initial and recurring service options.",
    detail:
      "Your logo. Your colors. Your prices. This is the customer-facing quote, shown with fictional customer details.",
  },
  {
    title: "They choose an available time.",
    short: "Self-booking",
    image: "demo-booking",
    alt: "CleanQuote self-booking calendar showing a fictional October 6 arrival window.",
    body: "Once approved, eligible quotes offer online booking. Customers pick from available arrival times, with any required deposit handled before scheduling.",
    detail:
      "Booking follows your availability and setup. Qualifying recurring service continues on the booked day.",
  },
];
const faqs = [
  [
    "Can customers really book without calling me?",
    "Yes, when online booking is enabled and the quote is eligible. Your widget gathers home details and sends a tailored quote by email. After approval and any required deposit, the customer can choose from available arrival times. Your working hours, capacity and booking settings still apply.",
  ],
  [
    "What makes the calculator different?",
    "Its starting estimates are informed by thousands of real cleaning visits. It considers the home and the type of clean, then applies your rates. As your team logs actual work, calibration uses your own company’s data to refine time estimates. You can review your pricing settings as your business changes.",
  ],
  [
    "Does the website widget display prices to everyone?",
    "No. The widget collects the request and emails the customer their quote. Each lead gets a price based on the details they supplied and your settings, with a link to review and approve.",
  ],
  [
    "Are credit card payments included?",
    "Stripe integration is included. Connect and configure your Stripe account to accept payments. Payment processing fees apply separately; subscription pricing does not include card or bank transaction fees.",
  ],
  [
    "How do the AI tools work?",
    "Connect a compatible AI app through CleanQuote’s MCP tools to look up business information and work with supported clients, quotes, jobs and schedules. Available actions depend on the permissions you grant. Setup and a compatible AI service are required; that service may charge separately. You can revoke a connection.",
  ],
  [
    "What costs extra?",
    "The optional Communications Hub is $49/month. Additional phone numbers are $5/month each, with usage charges separate. Enterprise can add team members for $9/month each. Payment processing, applicable taxes and any third-party AI subscription are separate.",
  ],
  [
    "Can I try it before choosing a plan?",
    "Yes. Start a 14-day free trial with no credit card required. Create a sample quote, explore the schedule and see how the workflow fits your cleaning business.",
  ],
];
---

<Layout
  title={title}
  description={description}
  canonical="https://thecleanquote.com/"
  ogTitle={title}
  ogDescription={description}
  ogUrl="https://thecleanquote.com/"
>
  <a class="skip-link" href="#main">
    Skip to content
  </a>
  <Nav home />
  <main id="main" class="home">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="audience">
            <span></span> Built for residential cleaning businesses
          </p>
          <h1>
            Book the clean.
            <br />
            Skip the phone tag.
          </h1>
          <p class="hero-lead">
            Let customers get a price built for their home and book their own
            cleaning. Keep your quotes, crew, schedule and payments together in
            CleanQuote.
          </p>
          <div class="hero-actions">
            <a class="button button-orange" href={TRIAL_URL}>
              Start Free Trial <Icon name="ArrowUpRight" />
            </a>
            <a class="text-link" href="#how-it-works">
              See how it works <Icon name="Play" class="w-4 h-4" />
            </a>
          </div>
          <p class="trial-note">14 days free. No credit card required.</p>
          <div class="hero-price">
            <strong>
              From $39<span>/month</span>
            </strong>
            <span>
              Big capability.
              <br />A small-business price.
            </span>
          </div>
        </div>
        <div class="hero-visual">
          <div class="workflow-label">
            <Icon name="MousePointerClick" />
            <span>From your website to your schedule</span>
          </div>
          <div class="hero-screen">
            <div class="screen-top">
              <span class="screen-dots" aria-hidden="true">
                <i></i>
                <i></i>
                <i></i>
              </span>
              <span>Your customer’s booking experience</span>
              <Icon name="LockKeyhole" class="w-4 h-4" />
            </div>
            <button
              class="image-zoom"
              data-zoom="/images/demo-booking.webp"
              aria-label="Enlarge the online booking screenshot"
            >
              <img
                src="/images/demo-booking.webp"
                alt="Actual CleanQuote booking screen with fictional demo data: a customer chooses an available arrival time."
                width="850"
                height="581"
                fetchpriority="high"
              />
            </button>
          </div>
          <div class="booking-note">
            <span class="round-check">
              <Icon name="Check" />
            </span>
            <div>
              <strong>The right price. A real opening.</strong>
              <span>A clear next step for your next customer.</span>
            </div>
          </div>
          <p class="demo-caption">
            Actual product screens. Fictional demonstration data.
          </p>
        </div>
      </div>
      <div class="wrap proof-strip">
        <p>
          <Icon name="ChartNoAxesCombined" />
          <span>
            Pricing informed by{" "}
            <strong>thousands of real cleaning visits</strong>
          </span>
        </p>
        <p>
          <Icon name="SlidersHorizontal" />
          <span>
            <strong>Your rates.</strong> Your business.
          </span>
        </p>
        <a href="#pricing">
          See plans & price comparisons{" "}
          <Icon name="ArrowDown" class="w-4 h-4" />
        </a>
      </div>
    </section>

    <section id="how-it-works" class="section tour-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="section-label">
            Your website can do more than collect a name.
          </p>
          <h2>
            Give every new lead
            <br />a way to become a booked job.
          </h2>
          <p>The customer moves forward while you keep running the business.</p>
        </div>
        <div class="tour">
          <div
            class="tour-tabs"
            role="tablist"
            aria-label="Explore the booking journey"
          >
            {steps.map((step, i) => (
              <button
                id={`tour-tab-${i}`}
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-controls={`tour-panel-${i}`}
                tabindex={i === 0 ? 0 : -1}
                data-step={i}
              >
                <span class="step-number">{i + 1}</span>
                {step.short}
                <Icon name="ChevronRight" class="w-4 h-4" />
              </button>
            ))}
          </div>
          {steps.map((step, i) => (
            <div
              id={`tour-panel-${i}`}
              role="tabpanel"
              aria-labelledby={`tour-tab-${i}`}
              tabindex="0"
              hidden={i !== 0}
              class="tour-panel"
            >
              <div class="tour-copy">
                <h3>{step.title}</h3>
                <p>{step.body}</p>
                <p class="tour-detail">{step.detail}</p>
                <a href={TRIAL_URL} class="text-link">
                  Try it with your business{" "}
                  <Icon name="ArrowUpRight" class="w-4 h-4" />
                </a>
              </div>
              <figure>
                <button
                  class="image-zoom"
                  data-zoom={`/images/${step.zoomImage || step.image}.webp`}
                  aria-label={`Enlarge ${step.short.toLowerCase()} screenshot`}
                >
                  <img
                    src={`/images/${step.image}.webp`}
                    alt={step.alt}
                    loading="lazy"
                    width="1000"
                    height="720"
                  />
                </button>
                <figcaption>
                  Actual CleanQuote screens with fictional customer details.
                  Quote prices calculated using Portland settings. Click to
                  enlarge.
                </figcaption>
              </figure>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="calculator" class="section calculator-section">
      <div class="wrap feature-split">
        <div class="feature-copy">
          <span class="feature-icon">
            <Icon name="Calculator" />
          </span>
          <p class="section-label">The calculator behind the quote</p>
          <h2>
            A pricing calculator you can trust.
            <br />
            Built on thousands of real cleanings.
          </h2>
          <p>
            Stop guessing how much a clean should cost. CleanQuote uses smart
            time-estimation math informed by thousands of real cleaning visits,
            then applies the rates you choose. A first clean, a recurring visit
            and a move-out each get a price that reflects the work involved.
          </p>
          <ul class="benefit-list">
            <li>
              <Icon name="Check" />
              <span>
                <strong>A price tailored to the home.</strong> Size, rooms,
                condition, pets, frequency and selected extras inform the
                estimate.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>Your business. Your prices.</strong> Set your own rates,
                including different rates by location. The calculator does the
                estimating; you stay in control of what you charge.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>A better fit as your business uses it.</strong> The
                recalibration engine learns from logged cleaning time to refine
                estimates around your team’s actual pace.
              </span>
            </li>
          </ul>
          <p class="small-note">
            Your rates stay yours. Recorded work helps refine the time estimates
            behind them.
          </p>
        </div>
        <div class="calculator-visual">
          <div class="formula-heading">
            <Icon name="House" />
            <span>Home details + estimated work + your rates</span>
          </div>
          <button
            class="image-zoom"
            data-zoom="/images/demo-calculator-full.webp"
            aria-label="Enlarge the cleaning estimate screenshot"
          >
            <img
              src="/images/demo-calculator-input.webp"
              alt="Actual calculator home inputs: 2,000 square feet, three bedrooms, two bathrooms and Portland’s $60 target rate."
              width="1200"
              height="600"
              loading="lazy"
            />
            <img
              src="/images/demo-pricing.webp"
              alt="Actual CleanQuote Pricing Calculator with a 2,000-square-foot sample home and Portland’s configured rate."
              width="1060"
              height="558"
              loading="lazy"
            />
          </button>
          <div class="learning-loop">
            <Icon name="RefreshCw" />
            <p>
              <strong>Quote. Clean. Track. Refine.</strong>
              <span>Your actual work helps inform the next estimate.</span>
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="features" class="section operations-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="section-label">Built for the work after the booking, too</p>
          <h2>
            Let the Schedule Organizer
            <br />
            plan your jobs automatically.
          </h2>
        </div>
        <div class="feature-split organizer-feature">
          <figure class="product-figure">
            <button
              class="image-zoom"
              data-zoom="/images/demo-organizer.webp"
              aria-label="Enlarge Schedule Organizer screenshot"
            >
              <img
                src="/images/demo-organizer.webp"
                alt="Schedule Organizer showing proposed changes for fictional sample homes, with an Apply Changes button."
                width="896"
                height="648"
                loading="lazy"
              />
            </button>
            <figcaption>
              Review the proposal before applying changes. Fictional
              demonstration data.
            </figcaption>
          </figure>
          <div class="feature-copy">
            <span class="feature-icon blue">
              <Icon name="CalendarRange" />
            </span>
            <h3>
              Stop rebuilding the week
              <br />
              one appointment at a time.
            </h3>
            <p>
              Turn a week of scheduling puzzles into a proposal you can review
              and apply. The Schedule Organizer uses customer preferences,
              cleaner availability and scheduling math to arrange jobs around
              preferred days, arrival windows and team assignments.
            </p>
            <ul class="plain-benefits">
              <li>
                Build scheduling suggestions for recurring visits automatically.
              </li>
              <li>
                Balance customer preferences, availability, travel and gaps.
              </li>
              <li>
                See partial matches and jobs that cannot fit, flagged for human
                review.
              </li>
              <li>
                Review the changes together, then apply the ones you choose.
              </li>
            </ul>
            <a class="text-link" href={TRIAL_URL}>
              Put your schedule in order{" "}
              <Icon name="ArrowUpRight" class="w-4 h-4" />
            </a>
          </div>
        </div>
        <figure class="product-figure calendar-showcase">
          <div class="showcase-heading">
            <div>
              <p class="section-label">The whole week, clearly laid out</p>
              <h3>A schedule your team can actually follow.</h3>
            </div>
            <span>Desktop calendar · Fictional jobs</span>
          </div>
          <button
            class="image-zoom"
            data-zoom="/images/demo-schedule.webp"
            aria-label="Enlarge the desktop cleaning calendar"
          >
            <img
              src="/images/demo-schedule.webp"
              alt="Actual CleanQuote desktop weekly calendar with forty fictional jobs, staggered from 8 AM to 5 PM and assigned to five color-coded cleaners."
              width="1840"
              height="910"
              loading="lazy"
            />
          </button>
          <figcaption>
            See job times and team assignments at a glance. As logged visits
            inform recalibration, your future estimates can better reflect the
            time your team needs.
          </figcaption>
        </figure>
        <div class="operations-grid">
          <article>
            <Icon name="Users" />
            <h3>One place for the customer story.</h3>
            <p>
              Keep clients, quotes, jobs, visit notes and invoices connected.
              Spend less time piecing together what happened before the next
              clean.
            </p>
          </article>
          <article>
            <Icon name="Timer" />
            <h3>Know where the hours went.</h3>
            <p>
              Track work time, compare estimated and actual hours, and use
              reports to spot jobs that deserve a closer look.
            </p>
          </article>
          <article>
            <Icon name="Smartphone" />
            <h3>Keep the crew in the loop.</h3>
            <p>
              Open CleanQuote on a phone to check the schedule, review job
              details and track time while the work is happening.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="team-time" class="section team-time-section">
      <div class="wrap feature-split">
        <div class="feature-copy">
          <span class="feature-icon blue">
            <Icon name="Timer" />
          </span>
          <p class="section-label">Timesheets, payroll & real working time</p>
          <h2>
            Track with Timesheets.
            <br />
            Run Payroll.
          </h2>
          <p>
            Bring job time, breaks and payroll preparation into the same
            workflow. Your team records the work; you get the hours you need to
            review, without rebuilding the week from messages and memory.
          </p>
          <ul class="benefit-list">
            <li>
              <Icon name="Check" />
              <span>
                <strong>Set your lunch and break rules.</strong> Choose
                durations and whether each is paid, so timesheets follow your
                business settings.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>Give payroll a clear rhythm.</strong> Set weekly,
                biweekly, twice-monthly or monthly pay periods. Review the
                hours, confirm the period and export a CSV.
              </span>
            </li>
            <li>
              <Icon name="Check" />
              <span>
                <strong>Make tracked time work twice.</strong> Compare estimated
                and actual cleaning time. Eligible logged visits also feed
                recalibration, helping the calculator reflect how your team
                works.
              </span>
            </li>
          </ul>
          <p class="small-note">
            Payroll tools support hours, pay-period review and exports. Payroll
            payments and tax filing are handled through your payroll process.
          </p>
        </div>
        <figure class="product-figure time-visual">
          <button
            class="image-zoom"
            data-zoom="/images/demo-timesheets.webp"
            aria-label="Enlarge timesheet, lunch and break settings"
          >
            <img
              src="/images/demo-timesheets.webp"
              alt="Actual CleanQuote settings for pay periods, paid ten-minute breaks and unpaid thirty-minute lunches, using demonstration settings."
              width="1040"
              height="811"
              loading="lazy"
            />
          </button>
          <figcaption>
            Your pay schedule. Your break rules. Demonstration settings.
          </figcaption>
        </figure>
      </div>
    </section>

    <section id="automations" class="section automation-section">
      <div class="wrap">
        <div class="section-heading">
          <p class="section-label">Sales pipeline & lifecycle automations</p>
          <h2>
            A new lead shouldn’t depend
            <br />
            on your next free minute.
          </h2>
          <p>
            See where each opportunity stands, then build follow-ups around the
            moments that matter. From the first inquiry to recurring service,
            your pipeline tells you what needs attention—and your automations
            help keep things moving.
          </p>
        </div>
        <ol class="pipeline-path" aria-label="Example customer lifecycle">
          <li>
            <span>01</span>
            <strong>New lead</strong>
            <p>Start the conversation.</p>
          </li>
          <li>
            <span>02</span>
            <strong>Quote sent</strong>
            <p>Follow up on the decision.</p>
          </li>
          <li>
            <span>03</span>
            <strong>Job booked</strong>
            <p>Help them prepare.</p>
          </li>
          <li>
            <span>04</span>
            <strong>Recurring customer</strong>
            <p>Keep the relationship going.</p>
          </li>
        </ol>
        <div class="feature-split automation-detail">
          <div class="feature-copy">
            <h3>
              Your message. Your timing.
              <br />A lot less remembering.
            </h3>
            <p>
              Build automated emails and texts around pipeline stages, upcoming
              visits, completed work and overdue invoices. Choose delays in
              minutes, hours or days, then set the message and sending window.
            </p>
            <ul class="plain-benefits">
              <li>Follow up when a quote has been waiting for a decision.</li>
              <li>
                Remind customers before a visit and check in after the clean.
              </li>
              <li>
                Build different sequences for new leads, recurring clients and
                cancelled service.
              </li>
              <li>Keep the next step visible in your sales pipeline.</li>
            </ul>
            <p class="small-note">
              Custom automated texts require the Communications Hub and
              messaging setup. Sending follows consent and contact preferences.
              Voicemail automation configuration is also supported; delivery
              requires the Hub and platform enablement and is paused by default.
            </p>
          </div>
          <figure class="product-figure automation-visual">
            <button
              class="image-zoom"
              data-zoom="/images/demo-automations.webp"
              aria-label="Enlarge example lifecycle automation rules"
            >
              <img
                src="/images/demo-automations.webp"
                alt="Actual CleanQuote automation cards showing fictional quote follow-up, visit reminder and after-clean email rules."
                width="1040"
                height="701"
                loading="lazy"
              />
            </button>
            <figcaption>
              Example rules in the real automation interface. No messages sent.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section connected-section">
      <div class="wrap connected-grid">
        <article class="payment-feature">
          <span class="feature-icon mint">
            <Icon name="CreditCard" />
          </span>
          <p class="section-label">Invoicing & Stripe payments</p>
          <h2>
            The clean is done.
            <br />
            Make paying easy.
          </h2>
          <p>
            Send a professional invoice with online payment options. Accept
            credit cards through Stripe, handle deposits and keep payment
            history connected to the customer.
          </p>
          <div class="payment-flow" aria-label="Invoice to payment workflow">
            <span>
              <Icon name="FileText" />
              Invoice
            </span>
            <Icon name="ArrowRight" />
            <span>
              <Icon name="CreditCard" />
              Online payment
            </span>
            <Icon name="ArrowRight" />
            <span>
              <Icon name="CircleCheck" />
              Record
            </span>
            <Icon name="ArrowRight" />
            <span>
              <Icon name="ChartNoAxesCombined" />
              Reporting
            </span>
          </div>
          <ul class="plain-benefits">
            <li>Card and supported bank payments</li>
            <li>Deposits and saved payment methods</li>
            <li>Invoices, balances and payment records together</li>
          </ul>
          <p class="small-note">
            Stripe setup required. Processing fees apply separately.
          </p>
        </article>
        <article class="ai-feature">
          <span class="feature-icon">
            <Icon name="Sparkles" />
          </span>
          <p class="section-label">AI connections through MCP</p>
          <h2>
            Your AI can work
            <br />
            with your business.
          </h2>
          <p>
            Connect a compatible AI app, including ChatGPT, Claude or Codex, to
            CleanQuote’s tools. Look up records and work with supported quotes,
            jobs and schedules through a conversation.
          </p>
          <div class="ai-prompts">
            <p>Example things to ask</p>
            <blockquote>“Show me the jobs coming up this week.”</blockquote>
            <blockquote>“Find the latest quote for Sample home A.”</blockquote>
          </div>
          <p class="ai-permissions">
            <Icon name="ShieldCheck" />
            <span>
              You choose the permissions.
              <br />
              You can revoke access.
            </span>
          </p>
          <p class="small-note">
            Connection setup and a compatible AI service required. Available
            actions depend on permissions; third-party charges may apply.
          </p>
        </article>
      </div>
    </section>
    <section id="communications" class="section communications-section">
      <div class="wrap communications-card">
        <div class="feature-copy">
          <span class="feature-icon">
            <Icon name="MessagesSquare" />
          </span>
          <p class="section-label">Optional Communications Hub</p>
          <h2>
            Keep the conversation
            <br />
            with the customer story.
          </h2>
          <p>
            A quote question, a schedule change, a quick update before the
            clean. Give your team a shared place for business calls and texts,
            with the customer’s work close at hand.
          </p>
          <a class="text-link" href="#pricing">
            Add the Hub for $49/month{" "}
            <Icon name="ArrowUpRight" class="w-4 h-4" />
          </a>
          <p class="small-note">
            Additional numbers $5/month each. Usage charges apply separately.
            Messaging setup required.
          </p>
        </div>
        <div class="hub-benefits">
          <article>
            <Icon name="Phone" />
            <div>
              <h3>A shared business inbox</h3>
              <p>
                Keep calls and texts together so the next person helping the
                customer has context.
              </p>
            </div>
          </article>
          <article>
            <Icon name="Send" />
            <div>
              <h3>Follow-ups with your wording</h3>
              <p>
                Use custom text automations to follow up at the right stage,
                with the timing and message you set.
              </p>
            </div>
          </article>
          <article>
            <Icon name="Users" />
            <div>
              <h3>Less searching between tools</h3>
              <p>
                Keep customer conversations closer to their quotes, jobs and
                visits.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>
    <Pricing />
    <section class="section faq-section">
      <div class="wrap faq-grid">
        <div>
          <p class="section-label">A few things you might be wondering</p>
          <h2>
            Know what
            <br />
            you’re getting.
          </h2>
          <p>
            Start with a sample quote. See how CleanQuote fits the way your
            company works.
          </p>
          <a class="button button-navy" href={TRIAL_URL}>
            Start Free Trial <Icon name="ArrowUpRight" />
          </a>
        </div>
        <div class="faqs">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>
                {question}
                <Icon name="Plus" class="w-5 h-5" />
              </summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
    <section class="final-cta">
      <div class="wrap">
        <div>
          <p>Less chasing. More cleaning.</p>
          <h2>
            Give your next customer
            <br />
            an easier way to book.
          </h2>
        </div>
        <div>
          <a class="button button-orange" href={TRIAL_URL}>
            Start Free Trial <Icon name="ArrowUpRight" />
          </a>
          <p class="trial-note">14 days free. No credit card required.</p>
        </div>
      </div>
    </section>
  </main>
  <Footer home />
  <dialog id="image-dialog" aria-label="Enlarged product screenshot">
    <form method="dialog">
      <button class="dialog-close" aria-label="Close enlarged screenshot">
        <Icon name="X" />
      </button>
    </form>
    <img alt="" />
    <p>Actual product screen with fictional demonstration data.</p>
  </dialog>
</Layout>
<script>
  const tabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-step]"),
  );
  const selectStep = (tab: HTMLButtonElement) => {
    tabs.forEach((item) => {
      const selected = item === tab;
      item.setAttribute("aria-selected", String(selected));
      item.tabIndex = selected ? 0 : -1;
      const panel = document.getElementById(
        item.getAttribute("aria-controls")!,
      );
      if (panel) panel.hidden = !selected;
    });
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectStep(tab));
    tab.addEventListener("keydown", (event) => {
      let next = index;
      if (event.key === "ArrowRight") next = (index + 1) % tabs.length;
      else if (event.key === "ArrowLeft")
        next = (index + tabs.length - 1) % tabs.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = tabs.length - 1;
      else return;
      event.preventDefault();
      selectStep(tabs[next]);
      tabs[next].focus();
    });
  });
  const dialog = document.querySelector<HTMLDialogElement>("#image-dialog");
  let opener: HTMLButtonElement | null = null;
  document
    .querySelectorAll<HTMLButtonElement>("[data-zoom]")
    .forEach((button) =>
      button.addEventListener("click", () => {
        if (!dialog) return;
        const img = dialog.querySelector("img")!;
        img.src = button.dataset.zoom!;
        img.alt = button.querySelector("img")?.alt || "Product screenshot";
        opener = button;
        dialog.showModal();
        dialog.scrollTop = 0;
      }),
    );
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
  dialog?.addEventListener("close", () => opener?.focus());
</script>
