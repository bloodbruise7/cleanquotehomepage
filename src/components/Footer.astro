---
import Logo from './Logo.astro';
import { LOGIN_URL } from '../site';

interface Props {
  home?: boolean;
}

const { home = false } = Astro.props;
const prefix = home ? '' : '/';

const columns = [
  {
    heading: 'Product',
    links: [
      { href: `${prefix}#calculator`, label: 'Calculator' },
      { href: `${prefix}#features`, label: 'Features' },
      { href: `${prefix}#pricing`, label: 'Pricing' },
    ],
  },
  {
    heading: 'Get started',
    links: [
      { href: LOGIN_URL, label: 'Start free trial' },
      { href: LOGIN_URL, label: 'Log in' },
    ],
  },
  {
    heading: 'Legal',
    links: [
      { href: '/privacy-policy/', label: 'Privacy Policy' },
      { href: '/terms-and-conditions/', label: 'Terms of Service' },
      { href: '/sms-consent/', label: 'SMS Consent' },
    ],
  },
];
---

<footer class="bg-white border-t border-line-card">
  <div class="max-w-6xl mx-auto px-6 py-14 grid gap-10 sm:grid-cols-2 md:grid-cols-4">
    <div class="sm:col-span-2 md:col-span-1">
      <a href="/" aria-label="CleanQuote home" class="inline-flex">
        <Logo class="text-2xl" />
      </a>
      <p class="mt-3 text-sm text-ink-secondary font-medium leading-relaxed max-w-xs">
        The pricing and operations system built for residential cleaning companies.
      </p>
    </div>

    {columns.map((col) => (
      <div>
        <div class="text-xs font-extrabold uppercase tracking-eyebrow text-ink-secondary mb-4">{col.heading}</div>
        <ul class="space-y-2.5 text-sm font-medium">
          {col.links.map((l) => (
            <li>
              <a href={l.href} class="text-ink-body hover:text-navy transition-colors duration-150">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
  <div class="border-t border-line-row">
    <div class="max-w-6xl mx-auto px-6 py-6 text-xs font-medium text-ink-muted flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
      <span>© 2026 CleanQuote LLC. All rights reserved.</span>
      <span>Built for residential cleaning businesses.</span>
    </div>
  </div>
</footer>
